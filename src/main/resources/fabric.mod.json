{
	"schemaVersion": 1,
	"id": "createintervalfilter",
	"version": "${version}",
	"name": "Create: Interval Filter",
	"description": "Adds a filter for deployers on contraptions that places items or blocks at set distance intervals.",
	"authors": [
		"ausmez"
	],
	"contact": {
		"homepage": "https://modrinth.com/mod/create-interval-filter",
		"sources": "https://github.com/ausmez/create-interval-filter"
	},
	"license": "GPL v3.0",
	"icon": "assets/createintervalfilter/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"dev.ausmez.createintervalfilter.CreateIntervalFilter"
		],
		"client": [
			"dev.ausmez.createintervalfilter.CreateIntervalFilterClient"
		],
		"fabric-datagen": [
			"dev.ausmez.createintervalfilter.CreateIntervalFilterDataGenerator"
		]
	},
	"mixins": [
		"createintervalfilter.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.2",
		"minecraft": "~1.20.1",
		"java": ">=17",
		"fabric-api": "*",
		"create": ">=6.0.7"
	}
}